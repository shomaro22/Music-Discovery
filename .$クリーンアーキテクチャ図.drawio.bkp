        </mxCell>
        <mxCell id="sysadmin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#5B21B6" value="System Admin&#xa;User / Role / Log&#xa;設定・監視" vertex="1">
          <mxGeometry height="75" width="150" x="40" y="420" as="geometry" />
        </mxCell>
        <mxCell id="frontend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;align=left;spacingLeft=10" value="React + Vite SPA&#xa;React Router / AuthContext&#xa;Access Token: メモリ&#xa;Refresh Token: HttpOnly Cookie&#xa;質問回答 / 推薦 / 管理画面" vertex="1">
          <mxGeometry height="190" width="210" x="260" y="185" as="geometry" />
        </mxCell>
        <mxCell id="api" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFFAFE;strokeColor=#0E7490;align=left;spacingLeft=10" value="Go + Echo REST API&#xa;:8080 / JSON&#xa;Request ID / Recover / Logger&#xa;Secure Header / CORS / Body Limit&#xa;JWT Auth / Role Guard / Rate Limit" vertex="1">
          <mxGeometry height="200" width="220" x="550" y="175" as="geometry" />
        </mxCell>
        <mxCell id="routes" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;align=left;spacingLeft=10" value="主要 API&#xa;/api/auth: signup, login, refresh, logout&#xa;/api/users/me: profile, withdraw&#xa;/api/questions, /api/answers&#xa;/api/recommendations, /daily-discovery&#xa;/api/feedbacks, /api/history&#xa;/api/admin: artists, songs, tags, users&#xa;/api/admin: roles, audit-logs, system-logs&#xa;/health" vertex="1">
          <mxGeometry height="240" width="275" x="835" y="90" as="geometry" />
        </mxCell>
        <mxCell id="postgres" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;align=left;spacingLeft=10" value="PostgreSQL 17&#xa;認証: users / refresh_tokens&#xa;楽曲: artists / songs / tags / 関連&#xa;質問: questions / choices / answers&#xa;嗜好: profiles / weight群&#xa;推薦: recommendations / details&#xa;学習: feedbacks&#xa;運用: audit_logs / system_logs / settings" vertex="1">
          <mxGeometry height="235" width="280" x="840" y="385" as="geometry" />
        </mxCell>
        <mxCell id="redis" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C" value="Redis 8&#xa;Rate Limit&#xa;短期・一時状態" vertex="1">
          <mxGeometry height="90" width="130" x="620" y="470" as="geometry" />
        </mxCell>
        <mxCell id="spotify" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;align=left;spacingLeft=8" value="Spotify Web API&#xa;Client Credentials&#xa;Track / Artist 情報取得&#xa;初期対象: OAuth・Playlist連携なし" vertex="1">
          <mxGeometry height="120" width="180" x="1185" y="155" as="geometry" />
        </mxCell>
        <mxCell id="ops" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;align=left;spacingLeft=8" value="運用基盤&#xa;Docker / CI・CD&#xa;Health Check / 監視&#xa;Backup / Restore&#xa;環境変数で秘密情報管理" vertex="1">
          <mxGeometry height="135" width="180" x="1185" y="385" as="geometry" />
        </mxCell>
        <mxCell id="principles" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#6D28D9;align=left;spacingLeft=12" value="設計方針&#xa;• Clean Architecture: Router → Controller → UseCase → Repository / Domain&#xa;• 依存性逆転: UseCase が Repository・Spotify・Clock の Port を所有&#xa;• 通常推薦と Daily Discovery は Recommendation を共通利用&#xa;• 推薦履歴は不変、推薦理由とスコアを保存して再計算しない&#xa;• 回答保存 + Profile更新、Feedback + Weight更新、管理操作 + AuditLog はTx&#xa;• Artist / Song / Tag / User は履歴整合性のため論理削除" vertex="1">
          <mxGeometry height="170" width="720" x="260" y="655" as="geometry" />
        </mxCell>
        <mxCell id="statusnote" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;dashed=1;align=left;spacingLeft=8" value="実装状況（ZIP時点）&#xa;実装済み: signup / login、users、refresh_tokens、基本Middleware&#xa;本図のその他要素: 要件・仕様に基づく目標構成" vertex="1">
          <mxGeometry height="100" width="340" x="1010" y="680" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="guest" style="html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=classic" target="frontend">
