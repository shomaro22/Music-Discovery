        <mxCell id="qgghb9D-P2rjfL67Yas5-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;align=left;spacingLeft=10" value="PostgreSQL&lt;br&gt;認証: users / refresh_tokens&lt;br&gt;楽曲: artists / songs / tags / 関連&lt;br&gt;質問: questions / choices / answers&lt;br&gt;嗜好: profiles / weight群&lt;br&gt;推薦: recommendations / details&lt;br&gt;学習: feedbacks&lt;br&gt;運用: audit_logs / system_logs / settings" vertex="1">
