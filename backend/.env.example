APP_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@postgres:5432/music_discovery?sslmode=disable
REDIS_ADDR=redis:6379
JWT_SECRET=change-this-to-a-random-secret-at-least-32-bytes
JWT_ISSUER=music-discovery
JWT_AUDIENCE=music-discovery-frontend
ACCESS_TOKEN_TTL_SECONDS=300
REFRESH_TOKEN_TTL_HOURS=720
REFRESH_TOKEN_COOKIE_NAME=refresh_token
CSRF_COOKIE_NAME=csrf_token
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_LOGIN_CAPACITY=20
RATE_LIMIT_LOGIN_RATE=0.333333
RATE_LIMIT_LOGIN_TTL_SECONDS=120
RATE_LIMIT_SIGNUP_CAPACITY=10
RATE_LIMIT_SIGNUP_RATE=0.166667
RATE_LIMIT_SIGNUP_TTL_SECONDS=120
RATE_LIMIT_REFRESH_CAPACITY=30
RATE_LIMIT_REFRESH_RATE=0.1
RATE_LIMIT_REFRESH_TTL_SECONDS=300
