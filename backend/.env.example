APP_ENV=development
APP_PORT=8080
DATABASE_URL=postgres://postgres:postgres@postgres:5432/music_discovery?sslmode=disable
JWT_SECRET=change-this-to-a-long-random-secret
REFRESH_TOKEN_SECRET=change-this-to-a-long-random-refresh-secret
ACCESS_TOKEN_EXPIRES_IN=5m
REFRESH_TOKEN_EXPIRES_IN=720h
REDIS_ADDR=redis:6379
CORS_ALLOW_ORIGIN=http://localhost:5173